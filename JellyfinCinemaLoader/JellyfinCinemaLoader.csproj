<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JellyfinCinemaLoader</RootNamespace>
    <AssemblyName>JellyfinCinemaLoader</AssemblyName>
    <!--
      Explicitly set: without this, the compiled .dll has no real
      version embedded at all and Jellyfin's own "My Plugins" list
      shows it as 0.0.0.0 regardless of what manifest.json says (the
      manifest version only controls WHICH package gets downloaded;
      the version Jellyfin actually DISPLAYS for an installed plugin
      is read from the compiled assembly itself). Bump this together
      with the manifest.json version on every new release, or the two
      will drift apart and "My Plugins" will show a stale number.
    -->
    <Version>1.0.3.0</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Jellyfin.Controller bringt alle Basis-Klassen mit, die ein Plugin
      braucht (BasePlugin, IHasWebPages, IServerEntryPoint, etc).
      Version 10.10.* passt zum tatsaechlichen Zielserver (10.10.7).
      Falls der Build wegen einer Versions-Inkompatibilitaet
      fehlschlaegt, ist DAS die erste Stelle, die wir gemeinsam
      anpassen.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.10.*" />
    <!--
      Explicit dependency: Plugin.cs constructs a real
      Newtonsoft.Json.Linq.JObject to hand to the File Transformation
      plugin's own RegisterTransformation method, which strictly
      requires that exact type (a plain C# anonymous object throws
      System.ArgumentException at the reflection Invoke call; this
      is exactly what happened in the very first real-world install
      test). Jellyfin.Controller likely already pulls this in
      transitively, but depending on that implicitly risks a "type
      not found" compile error if that ever changes; listing it
      directly here removes that risk entirely.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
